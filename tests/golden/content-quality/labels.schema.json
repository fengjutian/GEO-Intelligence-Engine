{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo.example/schemas/content-quality-label-v1.json",
  "title": "Content Quality Golden Label V1",
  "type": "object",
  "required": ["case_id", "split", "language", "page_type", "fixture", "fixture_sha256", "labels"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^CQ-[0-9]{5}$"},
    "split": {"enum": ["development", "validation", "locked_test"]},
    "language": {"type": "string"},
    "page_type": {"enum": ["home", "product", "documentation", "blog", "case_study", "faq", "other"]},
    "render_mode": {"enum": ["static", "javascript"]},
    "fixture": {"type": "string"},
    "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_code", "label", "evidence"],
        "properties": {
          "rule_code": {"type": "string"},
          "label": {"enum": ["present", "absent", "not_applicable", "uncertain"]},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "evidence": {"type": "array", "items": {"type": "object", "required": ["locator"], "properties": {"locator": {"type": "string"}, "quote": {"type": "string"}}}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "annotation": {"type": "object", "properties": {"annotators": {"type": "array", "items": {"type": "string"}}, "adjudicator": {"type": "string"}, "guide_version": {"type": "string"}}}
  },
  "additionalProperties": false
}
